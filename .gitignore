# Build outputs
dist/
build/
*.zip
!examples/*/expected_outputs/*.zip

# R artifacts
.Rhistory
.RData
.Rproj.user/
.Renviron
*.Rcheck/

# Compiled C/C++ objects (src/ is source-only)
*.o
*.so
*.dll
*.a
src/symbols.rds
# gcov coverage artifacts. These are TOOLCHAIN-SPECIFIC: a .gcda written
# by one GCC cannot be read by another's gcov, so committing them breaks
# the coverage job on any machine with a different compiler.
*.gcda
*.gcno
*.gcov

# Results folders generated by runs (preserved structure with .gitkeep)
results_*/

# OS-specific cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Audit work folders
otis_audit_*/

# Synthetic data outputs
SYNTHETIC_*.csv

# Downloaded test data (will be re-fetched on demand)
examples/*/a01_*.csv
examples/*/correctional_*.RData
PUSH_TO_GITHUB.md

# local Serena scope — never commit
.serena/
pkg-site/
*.tar.gz
cran-comments.md
# generated by ./configure from src/Makevars.in
src/Makevars
