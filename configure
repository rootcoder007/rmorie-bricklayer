#!/bin/sh
# Optional detection of liboqs (Open Quantum Safe).
#
# bricklayer's own post-quantum signature (XMSS over the bundled
# SHA-256) needs nothing and is always built. liboqs is looked for only
# to ADD the standardised lattice and hash-based schemes -- ML-DSA
# (FIPS 204) and SLH-DSA (FIPS 205) -- from a library that is tested and
# maintained for the purpose, rather than reimplementing them here.
#
# Absence is not an error. CRAN's build machines will not have liboqs,
# and the package must build there, so this script only ever ADDS flags.

PKG_CFLAGS=""
PKG_LIBS="-lcurl"
OQS_C=""
OQS_L=""

# 1. an explicit override always wins
if [ -n "${LIBOQS_CFLAGS}" ] || [ -n "${LIBOQS_LIBS}" ]; then
  echo "configure: using LIBOQS_CFLAGS/LIBOQS_LIBS from the environment"
  OQS_C="${LIBOQS_CFLAGS}"
  OQS_L="${LIBOQS_LIBS}"
  HAVE_OQS=yes
else
  HAVE_OQS=no
  # 2. pkg-config, if it knows about liboqs
  if command -v pkg-config >/dev/null 2>&1; then
    if pkg-config --exists liboqs 2>/dev/null; then
      echo "configure: found liboqs via pkg-config"
      OQS_C=`pkg-config --cflags liboqs 2>/dev/null`
      OQS_L=`pkg-config --libs liboqs 2>/dev/null`
      HAVE_OQS=yes
    fi
  fi
  # 3. a plain link probe, for a library installed without a
  #    pkg-config file
  if [ "${HAVE_OQS}" = "no" ]; then
    OQS_C=""
    OQS_L="-loqs"
    HAVE_OQS=probe
  fi
fi

# Whatever route proposed the flags, they are only believed once a
# program built with them has actually RUN. Linking is not enough: a
# library found through an explicit -L that the runtime loader does not
# search links cleanly and then fails at dyn.load, which installs a
# package that cannot be loaded at all.
#
# When the probe will not run, liboqs is DROPPED rather than propped up
# with -Wl,-rpath. An rpath would work on the build machine and bake its
# absolute path into the shared object, which is non-portable and is
# what CRAN's policy on PKG_LIBS flags is about. The same decision is
# taken in rmorie's configure, and the cost is small: ML-DSA and SLH-DSA
# are reported as unavailable by pqc_backends(), while the bundled XMSS
# signature has no system dependency and is unaffected.
#
# Note that the probe inherits the build shell's LD_LIBRARY_PATH. If
# liboqs is loadable only because that variable is set during the build,
# the probe passes and the resulting object needs the variable set
# forever after. Build in a clean environment.
if [ "${HAVE_OQS}" != "no" ]; then
  CC=`"${R_HOME}/bin/R" CMD config CC 2>/dev/null`
  if [ -z "${CC}" ]; then
    echo "configure: no C compiler reported by R CMD config CC"
    HAVE_OQS=no
  else
    cat > conftest_oqs.c <<'PROBE'
#include <oqs/oqs.h>
int main(void) {
    OQS_SIG *s = OQS_SIG_new("ML-DSA-65");
    if (s == 0) return 1;
    OQS_SIG_free(s);
    return 0;
}
PROBE
    OK=no
    if ${CC} conftest_oqs.c ${OQS_C} ${OQS_L} -o conftest_oqs \
         >/dev/null 2>&1; then
      if ./conftest_oqs >/dev/null 2>&1; then
        OK=yes
      else
        echo "configure: liboqs links but its probe will not run"
      fi
    fi
    rm -f conftest_oqs.c conftest_oqs conftest_oqs.o
    if [ "${OK}" = "yes" ]; then
      echo "configure: liboqs compiles, links and runs -- enabling it"
      PKG_CFLAGS="${PKG_CFLAGS} -DHAVE_LIBOQS ${OQS_C}"
      PKG_LIBS="${PKG_LIBS} ${OQS_L}"
      HAVE_OQS=yes
    else
      HAVE_OQS=no
    fi
  fi
fi

if [ "${HAVE_OQS}" = "no" ]; then
  echo "configure: liboqs not usable here -- building without it."
  echo "configure: the bundled XMSS signature is unaffected; ML-DSA and"
  echo "configure: SLH-DSA will be reported as unavailable by pqc_backends()."
fi

sed -e "s|@PKG_CFLAGS@|${PKG_CFLAGS}|" \
    -e "s|@PKG_LIBS@|${PKG_LIBS}|" \
    src/Makevars.in > src/Makevars

exit 0
