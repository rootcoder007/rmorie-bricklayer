# Generated from src/Makevars.in by ./configure -- edit the .in file.
# std::optional/<regex> in the vendored SIU core need C++17.
CXX_STD = CXX17
# libcurl as ./configure found it (pkg-config, curl-config, or the bare
# -lcurl), and zlib for the checked gzip reader (rmbl_gunzip.c). Nothing else
# is linked: the post-quantum schemes --
# XMSS, ML-KEM (FIPS 203), ML-DSA (FIPS 204), SLH-DSA (FIPS 205), HQC --
# are all implemented in this directory.
PKG_CPPFLAGS = @CURL_CFLAGS@
# R_NO_REMAP for C++: without it R's headers define length() and friends as macros, which
# break the C++ standard library headers when several sources share one compilation unit
PKG_CXXFLAGS = -DR_NO_REMAP
PKG_LIBS = @CURL_LIBS@ -lz

# Header dependencies. R's default rules rebuild an object when its .cpp
# changes but not when a header it includes changes; a warm build then
# tests stale code and a header fix looks as though it never landed
# (the shared morie_core.h, 2026-09-18). Explicit prerequisite lines are
# portable make, so every editor and every CI cache rebuilds correctly.
# `all` must stay the first target (Writing R Extensions 1.2.1): a rule
# listed before it would become the default goal and the shared object
# would never be linked.
# Every object file: the C sources, and rmbl_unity.o for all the C++ sources (rmbl_unity.cpp).
# A new C source must be added here; a new C++ source to rmbl_unity.cpp (test-src-hygiene.R
# checks both).
OBJECTS = init.o \
  rmbl_csv.o \
  rmbl_flock.o \
  rmbl_gunzip.o \
  rmbl_progress.o \
  rmbl_survey.o \
  rmbl_unity.o

all: $(SHLIB)
rmbl_unity.o: rmbl_asn1.cpp rmbl_barrier.cpp rmbl_core.cpp rmbl_digest.cpp rmbl_drbg.cpp rmbl_ecdsa.cpp rmbl_fetch.cpp rmbl_hqc.cpp rmbl_json.cpp rmbl_kdf.cpp rmbl_keccak.cpp rmbl_mgf1.cpp rmbl_mldsa_ntt.cpp rmbl_mlkem.cpp rmbl_pqc.cpp rmbl_series.cpp rmbl_siu.cpp rmbl_sketch.cpp rmbl_slhdsa.cpp rmbl_stats.cpp rmbl_strtod.cpp siu_parse.cpp siu_resolve.cpp morie_core.h rmbl_ascii.h rmbl_bignum.h rmbl_ct.h rmbl_drbg_core.h rmbl_entry.h rmbl_hqc_core.h rmbl_keccak.h rmbl_mask_rng.h rmbl_masked.h rmbl_mldsa_body.h rmbl_mldsa_core.h rmbl_mlkem_arith.h rmbl_mlkem_body.h rmbl_mlkem_core.h rmbl_prehash.h rmbl_slhdsa_body.h rmbl_slhdsa_core.h siu_parse.h siu_resolve.h siu_schema.h
rmbl_core.o: morie_core.h
rmbl_mldsa_ntt.o: rmbl_mldsa_core.h rmbl_prehash.h rmbl_mldsa_body.h rmbl_masked.h rmbl_mask_rng.h
rmbl_mlkem.o: rmbl_mlkem_core.h rmbl_mlkem_arith.h rmbl_mlkem_body.h rmbl_masked.h rmbl_mask_rng.h
rmbl_drbg.o: rmbl_drbg_core.h
rmbl_hqc.o: rmbl_hqc_core.h
rmbl_siu.o: siu_parse.h siu_resolve.h siu_schema.h
rmbl_slhdsa.o: rmbl_slhdsa_core.h rmbl_prehash.h rmbl_slhdsa_body.h
rmbl_stats.o: morie_core.h
siu_parse.o: siu_parse.h
siu_resolve.o: siu_resolve.h

# Every object depends on the shared helper headers: without these lines a
# header fix leaves stale objects in a warm build (which is how a corrected
# hex encoder tested as still broken on 2026-10-06).
rmbl_asn1.o rmbl_core.o rmbl_digest.o rmbl_drbg.o rmbl_ecdsa.o rmbl_fetch.o rmbl_hqc.o rmbl_kdf.o rmbl_keccak.o rmbl_mgf1.o rmbl_mldsa_ntt.o rmbl_mlkem.o rmbl_pqc.o rmbl_series.o rmbl_siu.o rmbl_sketch.o rmbl_slhdsa.o rmbl_stats.o rmbl_strtod.o rmbl_barrier.o: rmbl_entry.h rmbl_ct.h
rmbl_mldsa_ntt.o rmbl_mlkem.o rmbl_slhdsa.o rmbl_hqc.o rmbl_drbg.o: rmbl_ct.h
