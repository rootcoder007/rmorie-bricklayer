linters: linters_with_defaults(
    line_length_linter = line_length_linter(80L),
    # <<- is deliberate in the capsule and attest state machines (as in rmorie)
    assignment_linter = assignment_linter(operator = c("<-", "<<-")),
    object_name_linter = NULL,
    # air (air.toml) is the formatter in this repo; its continuation style
    # disagrees with indentation_linter, so the formatter wins.
    indentation_linter = NULL,
    # same-package calls resolve at load time; the linter cannot see them file by file
    object_usage_linter = NULL
  )
exclusions: list(
    # ports kept byte-for-byte against their reference implementations
    "R/json_native.R" = Inf,
    "R/sha256_native.R" = Inf,
    "R/RcppExports.R" = Inf,
    # JSON documents are written in single quotes so their double quotes need no escaping
    "tests/testthat/test-cran-stress-0_5_14.R" = list(quotes_linter = Inf),
    "inst" = Inf,
    "src" = Inf,
    "dev" = Inf,
    "data-raw" = Inf
  )
encoding: "UTF-8"
