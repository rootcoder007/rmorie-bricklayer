# Signed service document: the detached ML-DSA-44 signature covers these
# exact bytes, so no line-ending conversion on any platform (Windows
# checkouts default to autocrlf).
inst/services/* -text
*.sig -text
# Test fixtures whose bytes are pinned by sha256 in a signed bundle
tests/testthat/fixtures/** -text
# Test certificates for the x509 examples: exact DER bytes
inst/extdata/x509/*.der -text
# Shell scripts and the files they read keep LF on every checkout (a Windows
# checkout's CRLF broke configure.win: 'R/aaa_input_guards.R\r' not found)
configure text eol=lf
cleanup text eol=lf
configure.win text eol=lf
cleanup.win text eol=lf
inst/bundle/lib.txt text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.bat text eol=crlf
